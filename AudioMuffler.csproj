<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AudioMuffler</AssemblyName>
    <RootNamespace>AudioMuffler</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Cambiá esta ruta a tu instalación de Lethal Company -->
    <LCDir>C:\Program Files (x86)\Steam\steamapps\common\Lethal Company</LCDir>
    <Managed>$(LCDir)\Lethal Company_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToTestProfile" AfterTargets="Build">
    <PropertyGroup>
      <PluginTargetDir>C:\Users\panch\AppData\Roaming\com.kesomannen.gale\lethal-company\profiles\ImperiumPerformance\BepInEx\plugins\AudioMuffler</PluginTargetDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginTargetDir)" Condition="!Exists('$(PluginTargetDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginTargetDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginTargetDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>


</Project>
